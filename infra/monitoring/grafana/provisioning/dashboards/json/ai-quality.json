  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Thumbs-down rate by surface",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (surface) (rate(quality_events_total{kind=\"thumbs\",value=\"-1\"}[1d])) / clamp_min(sum by (surface) (rate(quality_events_total{kind=\"thumbs\"}[1d])), 1e-9)",
          "legendFormat": "{{surface}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Lesson CSAT (1–5)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (value) (rate(quality_events_total{kind=\"lesson_csat\"}[1d]))",
          "legendFormat": "csat {{value}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "Judge fail by dimension",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (dimension, rubric) (rate(quality_judge_fail_total[1d]))",
          "legendFormat": "{{rubric}} {{dimension}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 4,
      "title": "HTTP latency P95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"lingua-backend\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 5,
      "title": "LLM retries",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (call_type, reason) (rate(llm_retries_total[5m]))",
          "legendFormat": "{{call_type}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 6,
      "title": "Lesson generation LLM fail",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(llm_requests_total{call_type=\"lesson_json\",status!=\"ok\"}[5m]))",
          "legendFormat": "lesson_json error",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["lingua", "quality"],
  "templating": { "list": [] },
