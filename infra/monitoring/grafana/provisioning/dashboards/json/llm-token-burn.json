{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "LLM request rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (call_type, status) (rate(llm_requests_total[5m]))",
          "legendFormat": "{{call_type}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "tokens" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Token burn rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (direction, call_type) (rate(llm_tokens_total[5m]))",
          "legendFormat": "{{call_type}} {{direction}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Total tokens (cumulative)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(llm_tokens_total)",
          "legendFormat": "tokens",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "LLM latency P95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, call_type) (rate(llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{call_type}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "LLM retries",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (call_type, reason) (rate(llm_retries_total[5m]))",
          "legendFormat": "{{call_type}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "title": "LLM errors by status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (call_type, model, status) (rate(llm_requests_total{status!=\"ok\"}[5m]))",
          "legendFormat": "{{call_type}} {{model}} {{status}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["lingua", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
