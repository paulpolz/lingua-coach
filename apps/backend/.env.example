APP_ENV=local
LOG_LEVEL=INFO
METRICS_ENABLED=true

DATABASE_URL=postgresql+asyncpg://lingua:lingua@localhost:5432/lingua_coach

CLERK_SECRET_KEY=sk_test_...

# Clerk JWT issuer for JWKS verification (app/core/clerk_auth.py). Optional —
# if unset, any issuer matching https://*.clerk.accounts.dev is accepted
# (Clerk Development default). Derive this from your Clerk instance's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (base64-decode the part after `pk_test_`,
# prefix with `https://`, drop the trailing `$`), or leave blank for local dev.
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

GEMINI_API_KEY=...
GEMINI_MODEL_CHAT=gemini-3.6-flash
GEMINI_MODEL_LESSON=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_HOST=0.0.0.0
API_PORT=8000

CHAT_RATE_LIMIT_PER_HOUR=60
LESSON_START_RATE_LIMIT_PER_DAY=2
LLM_RPM_LIMIT=15
LLM_INPUT_TPM_LIMIT=250000
LLM_RPD_LIMIT=500
MAX_MESSAGE_CHARS=4000
CHAT_CONTEXT_MESSAGES=10
PACE_WINDOW_HOURS=24

# Pedagogy Markdown under `apps/backend/skills/` (see skills/README.md).
# Optional — defaults to `<backend_root>/skills` from this package layout.
# SKILLS_DIR=/absolute/path/to/skills

# Listening catalog YAML under `apps/backend/content/`. Optional — defaults to
# `<backend_root>/content`.
# CONTENT_DIR=/absolute/path/to/content
