# local | staging | production. Outside local, CLERK_JWT_ISSUER is required.
APP_ENV=local
LOG_LEVEL=INFO
METRICS_ENABLED=true

DATABASE_URL=postgresql+asyncpg://lingua:lingua@localhost:5432/lingua_coach

CLERK_SECRET_KEY=sk_test_...

# Clerk JWT issuer for JWKS verification (app/core/clerk_auth.py). Required when
# APP_ENV is staging or production (the app refuses to start without it). Only
# with APP_ENV=local may it be blank, which accepts any https://*.clerk.accounts.dev
# issuer. Derive it from NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (base64-decode the part
# after `pk_test_`, prefix with `https://`, drop the trailing `$`).
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev

# LLM provider (only `google`: Gemini via langchain-google-genai). These replace
# GEMINI_API_KEY / GEMINI_MODEL_* / GEMINI_TIMEOUT_SECONDS, which still work for one
# release with a startup warning.
LLM_PROVIDER=google
LLM_API_KEY=...
LLM_MODEL_CHAT=gemini-3.6-flash
LLM_MODEL_LESSON=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_HOST=0.0.0.0
API_PORT=8000

CHAT_RATE_LIMIT_PER_HOUR=60
LESSON_START_RATE_LIMIT_PER_DAY=2
LLM_RPM_LIMIT=15
LLM_INPUT_TPM_LIMIT=250000
LLM_RPD_LIMIT=500
MAX_MESSAGE_CHARS=4000
CHAT_CONTEXT_MESSAGES=10
PACE_WINDOW_HOURS=24
# Longest gap between lesson messages that still counts as practice time.
LESSON_IDLE_CAP_MINUTES=5

# LangSmith tracing: local and staging only (refused when APP_ENV=production).
# One project per environment: lingua-coach-local, lingua-coach-staging.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=lingua-coach-local

# Pedagogy Markdown under `apps/backend/skills/` (see skills/README.md).
# Optional — defaults to `<backend_root>/skills` from this package layout.
# SKILLS_DIR=/absolute/path/to/skills
