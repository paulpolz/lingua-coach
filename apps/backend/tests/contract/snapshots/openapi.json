    "/api/v1/auth/sync": {
      "post": {
        "description": "Idempotently upsert a `users` row keyed by `clerk_user_id`.\n\nCreates the row on first authenticated call; on subsequent calls,\nrefreshes the cached email if Clerk supplied one on the token.",
        "operationId": "sync_user_api_v1_auth_sync_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSyncResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Sync User",
        "tags": [
          "auth"
        ]
      }
    },
