            "title": "Pace Summary",
            "type": "string"
          },
          "pace_window_hours": {
            "title": "Pace Window Hours",
            "type": "integer"
          },
          "plan_days_done": {
            "title": "Plan Days Done",
            "type": "integer"
          },
          "plan_slip_days": {
            "title": "Plan Slip Days",
            "type": "integer"
          },
          "projected_completion_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Projected Completion At"
          },
          "target_plan_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Plan Days"
          }
        },
        "required": [
          "target_plan_days",
          "plan_days_done",
          "plan_slip_days",
          "projected_completion_at",
          "pace_window_hours",
          "pace_summary"
        ],
        "title": "ScheduleOut",
        "type": "object"
      },
      "TimeBudgetUpdate": {
        "properties": {
          "minutes_per_session": {
            "description": "Length of one lesson in minutes.",
            "maximum": 180.0,
            "minimum": 5.0,
            "title": "Minutes Per Session",
            "type": "integer"
          }
        },
        "required": [
          "minutes_per_session"
        ],
        "title": "TimeBudgetUpdate",
        "type": "object"
      },
      "TurnMetadata": {
        "description": "Stored on every assistant message and returned with the turn. Every key is always\npresent; each branch sets only what differs from the defaults.",
        "properties": {
          "corrections": {
            "items": {
              "$ref": "#/components/schemas/Correction"
            },
            "title": "Corrections",
            "type": "array"
          },
          "course_roadmap_draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CourseRoadmap"
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_updates": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Updates"
          },
          "practiced": {
            "items": {
              "$ref": "#/components/schemas/PracticeResult"
            },
            "title": "Practiced",
            "type": "array"
          },
          "suggest_finish": {
            "default": false,
            "title": "Suggest Finish",
            "type": "boolean"
          },
          "timing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TurnTiming"
              },
              {
                "type": "null"
              }
            ]
          },
          "tips": {
            "items": {
              "type": "string"
            },
            "title": "Tips",
            "type": "array"
          }
        },
        "title": "TurnMetadata",
        "type": "object"
      },
      "TurnTiming": {
        "properties": {
          "active_minutes": {
            "title": "Active Minutes",
            "type": "integer"
          },
          "target_minutes": {
            "title": "Target Minutes",
            "type": "integer"
          }
        },
        "required": [
          "active_minutes",
          "target_minutes"
        ],
        "title": "TurnTiming",
        "type": "object"
      },
      "UserReportOut": {
        "properties": {
          "body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body"
          },
          "report_type": {
            "$ref": "#/components/schemas/UserReportType"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "report_type"
        ],
        "title": "UserReportOut",
        "type": "object"
      },
      "UserReportType": {
        "enum": [
          "progress",
          "errors_log",
          "roadmap",
          "four_week_plan"
        ],
        "title": "UserReportType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
