{
  "$defs": {
    "Correction": {
      "properties": {
        "correction": {
          "title": "Correction",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "span": {
          "title": "Span",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "span",
        "correction",
        "type"
      ],
      "title": "Correction",
      "type": "object"
    },
    "MistakeEntry": {
      "properties": {
        "correction": {
          "title": "Correction",
          "type": "string"
        },
        "example_text": {
          "title": "Example Text",
          "type": "string"
        },
        "pattern_type": {
          "description": "Short stable label for a recurring error, e.g. 'missing articles'.",
          "minLength": 1,
          "title": "Pattern Type",
          "type": "string"
        }
      },
      "required": [
        "pattern_type",
        "example_text",
        "correction"
      ],
      "title": "MistakeEntry",
      "type": "object"
    },
    "PlanUpdates": {
      "properties": {
        "goal_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal Summary"
        },
        "grammar_mastery": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grammar Mastery"
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "target_plan_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Plan Days"
        },
        "time_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "topics": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topics"
        },
        "vocab_priorities": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocab Priorities"
        }
      },
      "title": "PlanUpdates",
      "type": "object"
    },
    "PracticeResult": {
      "properties": {
        "aspect": {
          "enum": [
            "grammar",
            "vocabulary",
            "review"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "item": {
          "description": "review: the mistake pattern_type exactly as listed; grammar: the point; vocabulary: the word.",
          "title": "Item",
          "type": "string"
        },
        "result": {
          "description": "solid: done correctly, ideally without help; shaky: wrong or needed help.",
          "enum": [
            "solid",
            "shaky"
          ],
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "aspect",
        "item",
        "result"
      ],
      "title": "PracticeResult",
      "type": "object"
    },
    "TimeBudget": {
      "properties": {
        "intensity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        },
        "minutes_per_session": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Length of one lesson in minutes (5-180); every lesson is timed to this. Required before a roadmap is drafted.",
          "title": "Minutes Per Session"
        },
        "sessions_per_week": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sessions Per Week"
        }
      },
      "title": "TimeBudget",
      "type": "object"
    }
  },
  "properties": {
    "content": {
      "description": "Learner-facing reply for this turn.",
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "corrections": {
      "description": "Corrections for this turn only.",
      "items": {
        "$ref": "#/$defs/Correction"
      },
      "title": "Corrections",
      "type": "array"
    },
    "mistakes": {
      "description": "One entry per recurring error pattern.",
      "items": {
        "$ref": "#/$defs/MistakeEntry"
      },
      "title": "Mistakes",
      "type": "array"
    },
    "plan_updates": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanUpdates"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Null unless the learner asks for a concrete plan change. Then include only the changed fields among goal_summary, level, time_budget, topics, vocab_priorities, target_plan_days, and grammar_mastery."
    },
    "practiced": {
      "description": "Items the learner practiced this turn and how it went.",
      "items": {
        "$ref": "#/$defs/PracticeResult"
      },
      "title": "Practiced",
      "type": "array"
    },
    "suggest_finish": {
      "default": false,
      "description": "True only in the closing recap, once the Time line shows the time budget is used.",
      "title": "Suggest Finish",
      "type": "boolean"
    },
    "tips": {
      "description": "Tips for this turn only.",
      "items": {
        "type": "string"
      },
      "title": "Tips",
      "type": "array"
    }
  },
  "required": [
    "content"
  ],
  "title": "LessonReply",
  "type": "object"
}
