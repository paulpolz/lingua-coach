  "properties": {
    "content": {
      "description": "Learner-facing reply for this turn.",
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "course_roadmap": {
      "anyOf": [
        {
          "$ref": "#/$defs/CourseRoadmap"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The full object on a new or revised plan. Null on a clarifying question."
    },
    "learner_profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/LearnerProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Include only once both languages are known, and again when they change."
    }
