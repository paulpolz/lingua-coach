    "CourseRoadmap": {
      "properties": {
        "adaptation_rules": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adaptation Rules"
        },
        "current_block": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseRoadmapCurrentBlock"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_milestone_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Milestone Index"
        },
        "learning_principles": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learning Principles"
        },
        "milestones": {
          "items": {
            "$ref": "#/$defs/CourseRoadmapMilestone"
          },
          "minItems": 1,
          "title": "Milestones",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/CourseRoadmapSummary"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "weekly_template": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourseRoadmapWeeklyTemplate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "version",
        "summary",
        "milestones"
      ],
      "title": "CourseRoadmap",
      "type": "object"
    },
    "CourseRoadmapActivity": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "minutes": {
          "title": "Minutes",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "minutes"
      ],
      "title": "CourseRoadmapActivity",
      "type": "object"
    },
    "CourseRoadmapCurrentBlock": {
      "properties": {
        "focus_summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Focus Summary"
        },
        "milestone_index": {
          "title": "Milestone Index",
          "type": "integer"
        },
        "themes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CourseRoadmapThemeDay"
